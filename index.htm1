<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Моя визитная карточка</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { min-height: 100vh; display: flex; justify-content: center; align-items: center; background: #0b0d15; padding: 20px; transition: background 0.4s; }
        .card { background: #ffffff; border-radius: 40px; padding: 40px 35px; max-width: 420px; width: 100%; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5); text-align: center; position: relative; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .card:hover { transform: translateY(-8px); box-shadow: 0 40px 80px rgba(0, 0, 0, 0.7); }
        .card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 120px; background: linear-gradient(135deg, #6a11cb, #2575fc); transition: background 0.5s; }
        .avatar { width: 110px; height: 110px; border-radius: 50%; background: linear-gradient(135deg, #6a11cb, #2575fc); margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; font-size: 48px; color: white; font-weight: bold; border: 4px solid white; box-shadow: 0 8px 20px rgba(106, 17, 203, 0.4); position: relative; z-index: 2; transition: 0.3s; }
        .avatar i { font-size: 50px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.2)); }
        .name { font-size: 28px; font-weight: 800; color: #1a1a2e; margin-top: 5px; letter-spacing: -0.5px; }
        .badge { display: inline-block; background: rgba(106, 17, 203, 0.12); color: #6a11cb; padding: 6px 18px; border-radius: 40px; font-size: 14px; font-weight: 600; margin: 10px 0 15px; letter-spacing: 0.3px; border: 1px solid rgba(106, 17, 203, 0.2); }
        .quote { font-size: 16px; color: #444; font-style: italic; margin: 12px 0 22px; line-height: 1.5; padding: 0 10px; }
        .counter-box { display: flex; justify-content: center; gap: 25px; background: #f5f7ff; padding: 18px 10px; border-radius: 60px; margin: 15px 0 22px; border: 1px solid #e9ecf5; }
        .counter-item { display: flex; flex-direction: column; }
        .counter-number { font-size: 24px; font-weight: 800; color: #1a1a2e; }
        .counter-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #777; font-weight: 600; }
        .socials { display: flex; justify-content: center; gap: 18px; margin: 25px 0 20px; }
        .social-btn { width: 50px; height: 50px; border-radius: 50%; border: none; background: #f0f2fa; color: #1a1a2e; font-size: 22px; cursor: pointer; transition: 0.25s ease; display: flex; align-items: center; justify-content: center; text-decoration: none; box-shadow: 0 4px 8px rgba(0,0,0,0.02); }
        .social-btn:hover { background: #6a11cb; color: white; transform: scale(1.12) translateY(-3px); box-shadow: 0 8px 20px rgba(106, 17, 203, 0.35); }
        .btn-primary { background: linear-gradient(135deg, #6a11cb, #2575fc); color: white; border: none; padding: 16px 30px; border-radius: 60px; font-size: 17px; font-weight: 700; width: 100%; cursor: pointer; transition: 0.3s; box-shadow: 0 8px 24px rgba(106, 17, 203, 0.35); letter-spacing: 0.5px; margin-top: 8px; }
        .btn-primary:hover { transform: scale(1.02); box-shadow: 0 12px 32px rgba(106, 17, 203, 0.5); }
        .btn-primary i { margin-right: 10px; }
        .theme-toggle { position: absolute; top: 18px; right: 20px; z-index: 10; background: rgba(255,255,255,0.2); border: none; color: white; font-size: 20px; cursor: pointer; border-radius: 40px; padding: 8px 14px; backdrop-filter: blur(6px); transition: 0.3s; }
        .theme-toggle:hover { background: rgba(255,255,255,0.4); transform: rotate(20deg); }
        body.dark { background: #0a0a12; }
        body.dark .card { background: #16162a; }
        body.dark .name { color: #f0f0ff; }
        body.dark .badge { background: rgba(255, 255, 255, 0.08); color: #b8a6ff; border-color: rgba(255,255,255,0.1); }
        body.dark .quote { color: #bbbbdd; }
        body.dark .counter-box { background: #21213a; border-color: #2e2e4a; }
        body.dark .counter-number { color: #f0f0ff; }
        body.dark .counter-label { color: #9999bb; }
        body.dark .social-btn { background: #26264a; color: #ddddff; }
        body.dark .social-btn:hover { background: #6a11cb; color: white; }
        @media (max-width: 480px) { .card { padding: 30px 20px; } .name { font-size: 24px; } .counter-box { gap: 15px; flex-wrap: wrap; } }
    </style>
</head>
<body>
    <div class="card" id="card">
        <button class="theme-toggle" id="themeToggle"><i class="fas fa-moon"></i></button>
        <div class="avatar" id="avatar"><i class="fas fa-user-astronaut"></i></div>
        <h1 class="name" id="userName">Екатерина Мощенская</h1>
        <span class="badge" id="userProfession">🚀 Веб-разработчик</span>
        <p class="quote" id="userQuote">«Код, который вдохновляет»</p>
        <div class="counter-box">
            <div class="counter-item"><span class="counter-number" id="counterValue">3</span><span class="counter-label">Года опыта</span></div>
            <div class="counter-item"><span class="counter-number" id="counterValue2">50</span><span class="counter-label">Проектов</span></div>
            <div class="counter-item"><span class="counter-number" id="counterValue3">100%</span><span class="counter-label">Отзывов</span></div>
        </div>
        <div class="socials">
            <a href="#" class="social-btn" id="tgLink" target="_blank"><i class="fab fa-telegram-plane"></i></a>
            <a href="#" class="social-btn" id="githubLink" target="_blank"><i class="fab fa-github"></i></a>
            <a href="#" class="social-btn" id="portfolioLink" target="_blank"><i class="fas fa-link"></i></a>
        </div>
        <button class="btn-primary" id="contactBtn"><i class="fas fa-paper-plane"></i> Связаться со мной</button>
        <div style="margin-top: 20px; font-size: 11px; color: #888; opacity: 0.6;">⚡ Готовый блок для личного бренда</div>
    </div>
    <script>
        const MY_DATA = {
            name: "Екатерина Мощенская",
            profession: "Веб-разработчик",
            quote: "«Код, который вдохновляет»",
            telegram: "https://t.me/ekaterina_dev",
            github: "https://github.com/ekaterinamoshchenskaia-coder",
            portfolio: "https://ekaterinamoshchenskaia-coder.github.io/my-card/",
            counter1: "3",
            counter2: "50",
            counter3: "100%",
            gradient1: "#6a11cb",
            gradient2: "#2575fc",
            avatarIcon: "fa-user-astronaut"
        };
        document.getElementById('userName').textContent = MY_DATA.name;
        document.getElementById('userProfession').textContent = MY_DATA.profession;
        document.getElementById('userQuote').textContent = MY_DATA.quote;
        document.getElementById('tgLink').href = MY_DATA.telegram;
        document.getElementById('githubLink').href = MY_DATA.github;
        document.getElementById('portfolioLink').href = MY_DATA.portfolio;
        document.getElementById('counterValue').textContent = MY_DATA.counter1;
        document.getElementById('counterValue2').textContent = MY_DATA.counter2;
        document.getElementById('counterValue3').textContent = MY_DATA.counter3;
        document.querySelector('.avatar i').className = `fas ${MY_DATA.avatarIcon}`;
        const gradientStyle = `linear-gradient(135deg, ${MY_DATA.gradient1}, ${MY_DATA.gradient2})`;
        document.querySelector('.card::before').style.background = gradientStyle;
        document.querySelector('.avatar').style.background = gradientStyle;
        document.querySelector('.btn-primary').style.background = gradientStyle;
        document.querySelector('.btn-primary').style.boxShadow = `0 8px 24px ${MY_DATA.gradient1}66`;
        document.getElementById('contactBtn').addEventListener('click', function() {
            window.open(MY_DATA.telegram, '_blank');
        });
        const themeBtn = document.getElementById('themeToggle');
        const icon = themeBtn.querySelector('i');
        themeBtn.addEventListener('click', function() {
            document.body.classList.toggle('dark');
            if (document.body.classList.contains('dark')) {
                icon.className = 'fas fa-sun';
            } else {
                icon.className = 'fas fa-moon';
            }
        });
        document.getElementById('card').style.opacity = '0';
        setTimeout(() => {
            const card = document.getElementById('card');
            card.style.transition = 'opacity 0.6s, transform 0.6s';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
        }, 150);
    </script>
</body>
</html>